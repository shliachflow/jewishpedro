---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormEmbed from '../../components/FormEmbed.astro';
import { getUpcomingEvents, formatDate } from '../../lib/events';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  return (await getUpcomingEvents()).map((e) => ({ params: { id: e.id }, props: { event: e } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const { title, date, time, location, image, rsvpUrl } = event.data;
---
<Base title={title}>
  <div class="page-head"><div class="container">
    <p><a href={url('/events')}>← All events</a></p>
    <h1>{title}</h1>
    <p class="page-sub">{formatDate(date)}{time && ` · ${time}`}{location && ` · ${location}`}</p>
  </div></div>
  <article class="container page prose">
    {image && <img src={url(image)} alt="" />}
    <Content />
    {rsvpUrl && <FormEmbed url={rsvpUrl} title={`RSVP: ${title}`} />}
  </article>
</Base>
