---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormEmbed from '../../components/FormEmbed.astro';
import { getUpcomingEvents, getOccurrences, formatDate, repeatLabel, horizon, today } from '../../lib/events';
import { googleLink } from '../../lib/ics';
import AddToCalendar from '../../components/AddToCalendar.astro';
import { url, site } from '../../lib/site';

export async function getStaticPaths() {
  return (await getUpcomingEvents()).map((o) => ({ params: { id: o.event.id }, props: { event: o.event, date: o.date } }));
}
const { event, date } = Astro.props;
const { Content } = await render(event);
const { title, time, location, image, rsvpUrl, repeat } = event.data;
const every = repeatLabel(event);
const pageUrl = new URL(url(`/events/${event.id}`), site.deploy.site).href;
const more = repeat ? (await getOccurrences(today(), horizon())).filter((o) => o.event.id === event.id).slice(1, 5) : [];
const a = site.address;
const atCenter = !location || location.includes(a.street);
const eventLd = {
  '@context': 'https://schema.org', '@type': 'Event', name: title,
  startDate: date,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: atCenter
    ? { '@type': 'Place', name: site.name, address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, addressRegion: a.state, postalCode: site.zip, addressCountry: 'US' } }
    : { '@type': 'Place', name: location },
  organizer: { '@type': 'Organization', name: site.name },
};
---
<Base title={title} description={`${title}, ${formatDate(date)}${time ? ', ' + time : ''}.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventLd)} />
  <div class="page-head"><div class="container">
    <p><a href={url('/events')}>← All events</a></p>
    <h1>{title}</h1>
    <p class="page-sub">{every ? `${every} · ` : ''}{formatDate(date)}{time && ` · ${time}`}{location && ` · ${location}`}</p>
  </div></div>
  <article class="container page prose">
    {image && <img src={url(image)} alt="" />}
    <Content />
    <AddToCalendar google={googleLink(event, date, pageUrl)} ics={url(`/events/${event.id}.ics`)} series={!!repeat} />
    {more.length > 0 && <p class="next-dates"><strong>Next dates:</strong> {more.map((o) => formatDate(o.date).replace(/, \d{4}$/, '')).join(' · ')}</p>}
    {rsvpUrl && <FormEmbed url={rsvpUrl} title={`RSVP: ${title}`} />}
  </article>
</Base>
