---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormEmbed from '../components/FormEmbed.astro';
import ContactForm from '../components/ContactForm.astro';
import { getLivePages } from '../lib/pages';
import { url } from '../lib/site';

export async function getStaticPaths() {
  const pages = await getLivePages();
  return pages.filter((p) => p.id !== 'home' && p.id !== 'holidays').map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content, headings } = await render(page);
const { title, description, image, formUrl, contactForm, layout } = page.data;
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 4 && toc.length <= 18;
---
<Base title={title} description={description}>
  <div class="page-head"><div class="container">
    <h1>{title}</h1>
    {description && <p class="page-sub">{description}</p>}
  </div></div>
  <div class:list={['container', 'page', 'page-body', showToc && 'has-toc']}>
    <article class:list={['prose', layout && `prose-${layout}`]}>
      {image && <img class="page-image" src={url(image)} alt="" />}
      <Content />
      {contactForm && <ContactForm />}
      {formUrl && <FormEmbed url={formUrl} title={title} />}
    </article>
    {showToc && (
      <nav class="toc" aria-label="On this page">
        <p>On this page</p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
  </div>
</Base>
