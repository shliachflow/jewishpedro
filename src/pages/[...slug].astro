---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormEmbed from '../components/FormEmbed.astro';
import ContactForm from '../components/ContactForm.astro';
import { getLivePages } from '../lib/pages';
import PageCta from '../components/PageCta.astro';
import { url } from '../lib/site';

export async function getStaticPaths() {
  const pages = await getLivePages();
  return pages.filter((p) => p.id !== 'home' && p.id !== 'holidays').map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content, headings } = await render(page);
const { title, description, image, formUrl, contactForm, layout, heroImage, heroAlt } = page.data;
---
<Base title={title} description={description}>
  <div class:list={['page-head', heroImage && 'has-photo']}><div class="container page-head-grid">
    <div>
      <h1>{title}</h1>
      {description && <p class="page-sub">{description}</p>}
    </div>
    {heroImage && <img class="page-head-photo" src={url(heroImage)} alt={heroAlt ?? ''} fetchpriority="high" />}
  </div></div>
  <div class="container page page-body">
    <article class:list={['prose', layout && `prose-${layout}`]}>
      {image && <img class="page-image" src={url(image)} alt="" />}
      <Content />
      {contactForm && <ContactForm />}
      {formUrl && <FormEmbed url={formUrl} title={title} />}
    </article>
  </div>
  <PageCta />
</Base>
