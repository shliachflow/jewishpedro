---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShabbosBox from '../components/ShabbosBox.astro';
import EventCard from '../components/EventCard.astro';
import { getUpcomingEvents } from '../lib/events';
import { site, url } from '../lib/site';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const upcoming = (await getUpcomingEvents()).slice(0, 3);
---
<Base description={site.description}>
  <section class="hero">
    <div class="container">
      <h1>{home.data.title}</h1>
      <div class="hero-text"><Content /></div>
      <p class="hero-actions">
        <a class="btn" href={url('/events')}>Upcoming events</a>
        <a class="btn btn-outline" href={url('/programs')}>Our programs</a>
      </p>
    </div>
  </section>

  <div class="container"><ShabbosBox /></div>

  <section class="container section">
    <h2>Upcoming events</h2>
    {upcoming.length === 0
      ? <p>No events scheduled right now. Check back soon.</p>
      : <div class="event-list">{upcoming.map((e) => <EventCard event={e} />)}</div>}
    <p><a href={url('/events')}>See all events →</a></p>
  </section>

  {home.data.featured && (
    <section class="container section">
      <h2>Get involved</h2>
      <ul class="featured">
        {home.data.featured.map((f) => (
          <li>
            {f.image && <img src={url(f.image)} alt="" loading="lazy" />}
            <h3><a href={url(f.href)}>{f.title}</a></h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
