---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShabbosBox from '../components/ShabbosBox.astro';
import EventRow from '../components/EventRow.astro';
import { getUpcomingEvents } from '../lib/events';
import { site, url } from '../lib/site';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const upcoming = (await getUpcomingEvents()).slice(0, 3);
const { heroImage, heroAlt, featured } = home.data;
---
<Base description={site.description}>
  <section class:list={['hero', heroImage && 'has-photo']} style={heroImage ? `--hero-img:url('${url(heroImage)}')` : undefined}>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{home.data.title}</h1>
        <div class="hero-text"><Content /></div>
        <p class="hero-actions">
          <a class="btn btn-brass" href={url('/shabbat-experience')}>Join us Saturday morning</a>
          <a class="btn btn-ghost" href={url('/contact')}>Say hello</a>
        </p>
      </div>
      <ShabbosBox />
    </div>
    {heroImage && <span class="sr-only">{heroAlt}</span>}
  </section>

  {featured && (
    <section class="container section">
      <h2>Explore</h2>
      <ul class="directory">
        {featured.map((f) => (
          <li>
            <a href={url(f.href)}>
              <span class="dir-title">{f.title}</span>
              <span class="dir-text">{f.text}</span>
              <span class="dir-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="band">
    <div class="container">
      <h2>Coming up</h2>
      {upcoming.length === 0
        ? <p>No events scheduled right now. Check back soon.</p>
        : <div class="event-rows">{upcoming.map((e) => <EventRow event={e} />)}</div>}
      <p class="more"><a href={url('/events')}>All upcoming events →</a></p>
    </div>
  </section>
</Base>
