---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShabbosBox from '../components/ShabbosBox.astro';
import EventRow from '../components/EventRow.astro';
import { getUpcomingEvents } from '../lib/events';
import { site, url } from '../lib/site';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const upcoming = (await getUpcomingEvents()).slice(0, 3);
const { heroImage, heroAlt, heroExtras, peoplePhoto, peoplePhotoAlt, feature, mission, people, featured } = home.data;
const style = site.theme.hero ?? 'split';
const h1 = home.data.title.replace('S. Pedro', '<span class="accent">S. Pedro</span>');
const lead = featured?.find((f) => f.image);
const rest = featured?.filter((f) => f !== lead) ?? [];
const a = site.address;
const fullAddress = `${a.street}, ${a.city}, ${a.state} ${a.zip}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---
<Base description={site.description}>
  <section class:list={['hero', `hero-${style}`]}>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 set:html={h1} />
        <div class="hero-text"><Content /></div>
        <p class="hero-actions">
          <a class="btn btn-brass" href={url('/shabbat-experience')}>Join us Saturday morning</a>
          <a class="btn btn-ghost" href={url('/contact')}>Say hello</a>
        </p>
      </div>
      {style === 'split' && heroImage && <img class="hero-photo" src={url(heroImage)} alt={heroAlt ?? ''} />}
      {style === 'collage' && heroImage && (
        <div class="collage">
          <img class="c1" src={url(heroImage)} alt={heroAlt ?? ''} />
          {heroExtras?.[0] && <img class="c2" src={url(heroExtras[0].image)} alt={heroExtras[0].alt} />}
          {heroExtras?.[1] && <img class="c3" src={url(heroExtras[1].image)} alt={heroExtras[1].alt} />}
        </div>
      )}
    </div>
    {style === 'collage' && (
      <svg class="tide" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0,30 C240,6 480,54 720,30 C960,6 1200,54 1440,30" /></svg>
    )}
  </section>

  <div class="container board-wrap"><ShabbosBox /></div>

  {feature && (
    <section class="feature-band">
      <div class="container feature-grid">
        <img src={url(feature.image)} alt={feature.alt} loading="lazy" />
        <div>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
          <p><a class="btn" href={url(feature.href)}>Plan your visit</a></p>
        </div>
      </div>
    </section>
  )}

  {featured && (
    <section class="container section">
      <h2>Explore</h2>
      <div class="explore">
        {lead && (
          <a class="explore-lead" href={url(lead.href)}>
            <img src={url(lead.image!)} alt={lead.alt ?? ''} loading="lazy" />
            <span class="explore-cap"><strong>{lead.title}</strong><span>{lead.text}</span></span>
          </a>
        )}
        <ul class="directory">
          {rest.map((f) => (
            <li>
              <a href={url(f.href)}>
                <span class="dir-title">{f.title}</span>
                <span class="dir-text">{f.text}</span>
                <span class="dir-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {mission && (
    <section class="mission">
      <div class:list={['container', 'mission-grid', peoplePhoto && 'has-photo']}>
        {peoplePhoto && <img class="mission-photo" src={url(peoplePhoto)} alt={peoplePhotoAlt ?? ''} loading="lazy" />}
        <div>
          <p class="mission-text">{mission}</p>
          {people && (
            <ul class="people">
              {people.map((p) => (<li><strong>{p.name}</strong><span>{p.role}</span></li>))}
            </ul>
          )}
          <p class="more"><a href={url('/about')}>Our story →</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="container">
      <h2>Coming up</h2>
      {upcoming.length === 0
        ? <p>No events scheduled right now. Check back soon.</p>
        : <div class="event-rows">{upcoming.map((e) => <EventRow event={e} />)}</div>}
      <p class="more"><a href={url('/events')}>All upcoming events →</a></p>
    </div>
  </section>

  <section class="visit">
    <div class="container visit-grid">
      <div>
        <h2>Come visit</h2>
        <p class="visit-addr">{a.street}<br />{a.city}, {a.state} {a.zip}</p>
        <p><a class="btn btn-brass" href={directions}>Get directions</a></p>
        <p class="visit-contact"><a href={`tel:${site.phone}`}>{site.phone}</a> · <a href={site.social.whatsapp}>WhatsApp</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      {site.shabbos.services && (
        <div class="visit-times">
          <h3>Every Saturday</h3>
          <p>{site.shabbos.services.replace(/^Saturday morning at [^:]*:\s*/, '')}</p>
        </div>
      )}
    </div>
  </section>
</Base>
