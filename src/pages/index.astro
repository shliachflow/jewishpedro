---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShabbosBox from '../components/ShabbosBox.astro';
import EventRow from '../components/EventRow.astro';
import { getUpcomingEvents } from '../lib/events';
import { getGallery } from '../lib/gallery';
import { site, url } from '../lib/site';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing. The homepage is built from it; do not delete or rename it.');
const { Content } = await render(home);
const upcoming = (await getUpcomingEvents()).slice(0, 3);
const gallery = await getGallery();
const { heroImage, heroImageMobile, heroAlt, heroFocus, heroFocusMobile, visitPhoto, visitAlt, peoplePhoto, peoplePhotoAlt, communityPhoto, communityAlt, feature, mission, people, featured, accent } = home.data;
const ui = site.ui;
const style = site.theme.hero ?? 'split';
const h1 = accent && home.data.title.includes(accent) ? home.data.title.replace(accent, `<span class="accent">${accent}</span>`) : home.data.title;
const lead = featured?.find((f) => f.image);
const rest = featured?.filter((f) => f !== lead) ?? [];
const a = site.address;
const fullAddress = `${a.street}, ${a.city}, ${a.state} ${site.zip}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const sv = site.shabbos.services;
---
<Base description={site.description} overHero jsonLd>
  {style === 'photo' && heroImage && <link slot="head" rel="preload" as="image" href={url(heroImage)} media="(min-width: 40.01rem)" fetchpriority="high" />}
  {style === 'photo' && heroImage && <link slot="head" rel="preload" as="image" href={url(heroImageMobile ?? heroImage)} media="(max-width: 40rem)" fetchpriority="high" />}
  <section class:list={['hero', `hero-${style}`]} style={style === 'photo' && heroImage ? `--hero-img:url('${url(heroImage)}');--hero-img-m:url('${url(heroImageMobile ?? heroImage)}');--hero-pos:${heroFocus ?? '40% 42%'};--hero-pos-m:${heroFocusMobile ?? '17% 46%'}` : undefined}>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 set:html={h1} />
        <div class="hero-text"><Content /></div>
        <p class="hero-actions">
          <a class="btn btn-brass" href={url(ui.primaryCta.href)}>{ui.primaryCta.label}</a>
          <a class="btn btn-ghost" href={url(ui.secondaryCta.href)}>{ui.secondaryCta.label}</a>
        </p>
      </div>
      {style === 'split' && heroImage && <img class="hero-split-photo" src={url(heroImage)} alt={heroAlt ?? ''} />}
    </div>
    {style === 'photo' && heroAlt && <span class="sr-only">{heroAlt}</span>}
  </section>

  <div class="container board-wrap"><ShabbosBox /></div>

  {feature && (
    <section class="feature-hero" style={`--feat-img:url('${url(feature.image)}')`} data-reveal>
      <div class="container feature-hero-inner">
        {sv && <p class="eyebrow">{ui.weeklyLabel}: {sv.detail}</p>}
        <h2>{feature.title}</h2>
        <p>{feature.text}</p>
        <p><a class="btn btn-brass" href={url(feature.href)}>{ui.featureCta}</a></p>
      </div>
    </section>
  )}

  <section class="band">
    <div class="container">
      <p class="eyebrow">{ui.comingUpHeading}</p>
      <h2 class="big-h">{ui.comingUpTitle}</h2>
      {upcoming.length === 0
        ? <p>{ui.noEvents}</p>
        : <div class="event-rows">{upcoming.map((e) => <EventRow occ={e} />)}</div>}
      <p class="more"><a href={url('/events')}>{ui.allEvents}</a> <a href={url('/calendar')}>Month calendar →</a> <a href={url('/planner')}>Printable planner →</a></p>
    </div>
  </section>

  {featured && (
    <section class="container section explore-section">
      <p class="eyebrow">{ui.exploreHeading}</p>
      <h2 class="big-h">{ui.exploreTitle}</h2>
      <div class="tiles">
        {featured.map((f, i) => (
          <a class:list={['tile', { 'tile-lead': f === lead, 'tile-dark': i % 2 === 1 }]} href={url(f.href)} data-reveal>
            {f.image && <img src={url(f.image)} alt={f.alt ?? ''} loading="lazy" decoding="async" />}
            <span class="tile-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="tile-body"><strong>{f.title}</strong><span>{f.text}</span></span>
            <span class="tile-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="more"><a href={url('/programs')}>All programs →</a></p>
    </section>
  )}

  {mission && (
    <section class="mission">
      <div class:list={['container', 'mission-grid', peoplePhoto && 'has-photo']}>
        {peoplePhoto && <img class="mission-photo" src={url(peoplePhoto)} alt={peoplePhotoAlt ?? ''} loading="lazy" decoding="async" />}
        <div>
          <p class="mission-text">{mission}</p>
          {people && (
            <ul class="people">
              {people.map((p) => (<li><strong>{p.name}</strong><span>{p.role}</span></li>))}
            </ul>
          )}
          <p class="more"><a href={url(ui.storyLink.href)}>{ui.storyLink.label}</a></p>
        </div>
      </div>
    </section>
  )}

  {gallery.length > 0 && (
    <section class="container section gal-section" data-reveal>
      <div class="gal-head">
        <div><p class="eyebrow">{ui.galleryLabel}</p><h2 class="big-h">{ui.galleryTitle}</h2></div>
        <a class="btn btn-line" href={url('/gallery')}>{ui.galleryCta}</a>
      </div>
      <div class="gal-strip">{gallery.slice(0, 4).map((g) => <a href={url('/gallery')} aria-label={g.caption}><img src={g.src} alt={g.caption} width={g.width} height={g.height} loading="lazy" decoding="async" /></a>)}</div>
    </section>
  )}

  <section class="follow">
    <div class="container follow-inner">
      <h2>{ui.followHeading}</h2>
      <p><a class="btn btn-line" href={site.social.facebook}>{ui.socialLabels.facebook}</a> <a class="btn btn-line" href={site.social.instagram}>{ui.socialLabels.instagram}</a></p>
    </div>
  </section>

  <section class="visit">
    <div class="container visit-grid">
      <div>
        <p class="eyebrow">{ui.visitHeading}</p>
        <h2 class="big-h">{ui.visitTitle}</h2>
        <p class="visit-addr">{a.street}<br />{a.city}, {a.state} {site.zip}</p>
        <p><a class="btn btn-brass" href={directions}>{ui.directionsLabel}</a></p>
        {sv && <p class="visit-times"><strong>{ui.weeklyLabel}</strong> {sv.detail}</p>}
        <p class="visit-contact"><a href={`tel:${site.phone}`}>{site.phone}</a> · <a href={site.social.whatsapp}>{ui.socialLabels.whatsapp}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="visit-map">
        <iframe title={`Map: ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer" src={`https://maps.google.com/maps?q=${encodeURIComponent(fullAddress)}&z=15&output=embed`}></iframe>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('reveal-on');
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.12 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</Base>
