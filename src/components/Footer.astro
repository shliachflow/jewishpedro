---
import { site, url } from '../lib/site';
const a = site.address;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{site.name}</p>
      <p>{a.street}<br />{a.city}, {a.state} {a.zip}</p>
      <p><a href={`tel:${site.phone}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <nav aria-label="Footer">
      <p class="footer-head">Explore</p>
      <ul>{site.footerLinks.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}</ul>
    </nav>
    <div>
      <p class="footer-head">Connect</p>
      <ul>
        {Object.entries(site.social).map(([name, href]) => <li><a href={href}>{name[0].toUpperCase() + name.slice(1)}</a></li>)}
        <li><a href={site.donate.url}>{site.donate.label}</a></li>
      </ul>
    </div>
  </div>
  <p class="container copyright">&copy; {year} {site.name}</p>
</footer>
