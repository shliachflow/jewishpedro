---
interface Props { google: string; ics: string; series?: boolean }
const { google, ics, series = false } = Astro.props;
---
<div class="add-cal">
  <span class="add-cal-label">Add to calendar{series ? ' (all dates)' : ''}:</span>
  <a class="btn btn-line" href={google} target="_blank" rel="noopener">Google Calendar</a>
  <a class="btn btn-line" href={ics}>Apple / Outlook (.ics)</a>
</div>
