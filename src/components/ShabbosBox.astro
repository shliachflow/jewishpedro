---
// Swappable Shabbos box, laid out as a horizontal timetable board.
// Times are calculated at build time (Hebcal's library), and the daily deploy keeps them current. Settings come from site.config.json.
import { site } from '../lib/site';
import { jewishDays } from '../lib/jewish';
import { today, addDays } from '../lib/events';
const s = site.shabbos;
const ui = site.ui;
// On Saturday, start from Friday so candle lighting and havdalah belong to the same Shabbos.
const t0 = today();
const from = new Date(`${t0}T12:00:00`).getDay() === 6 ? addDays(t0, -1) : t0;
const days = [...jewishDays(new Date(`${from}T12:00:00`), new Date(`${addDays(t0, 8)}T12:00:00`))];
const find = (kind: string) => days.flatMap(([, d]) => d.items).find((i) => i.kind === kind);
const built = { candles: find('candles')?.time, havdalah: find('havdalah')?.time, parsha: find('parsha')?.text.replace(/^Parashat\s+/, '') };
---
<section class="shabbos-box" aria-labelledby="shabbos-h">
  <div class="board-title">
    <h2 id="shabbos-h">{ui.shabbatHeading}</h2>
    <p data-field="parsha">{built.parsha ? ui.parshaPrefix + built.parsha : '\u00a0'}</p>
  </div>
  <dl class="board-times">
    <div><dt>{ui.candleLabel}</dt><dd data-field="candles">{built.candles ?? '…'}</dd></div>
    <div><dt>{ui.havdalahLabel}</dt><dd data-field="havdalah">{built.havdalah ?? '…'}</dd></div>
  </dl>
  <div class="board-info">
    {s.services && <p>{s.services.label} at {site.address.street}: {s.services.detail}</p>}
    {!built.candles && <p class="shabbos-note">{ui.timesUnavailable}</p>}
    <a class="shabbos-link" href={s.zemanimUrl}>{ui.zemanimLabel}</a>
  </div>
</section>
