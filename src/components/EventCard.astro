---
import { formatDate } from '../lib/events';
import { url } from '../lib/site';
interface Props { event: any; compact?: boolean }
const { event, compact = false } = Astro.props;
const { title, date, time, location, image } = event.data;
---
<article class={compact ? 'event-row' : 'event-card'}>
  {!compact && image && <img src={url(image)} alt="" loading="lazy" />}
  <div>
    <p class="event-date">{formatDate(date)}{time && ` · ${time}`}</p>
    <h3><a href={url(`/events/${event.id}`)}>{title}</a></h3>
    {location && <p class="event-location">{location}</p>}
  </div>
</article>
