---
import { site, url } from '../lib/site';
const suffix = site.name.replace(site.shortName, '').trim();
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span>{site.address.street}, {site.address.city}</span>
      <span class="topbar-links">
        <a href={`tel:${site.phone}`}>{site.phone}</a>
        <a href={site.social.whatsapp}>WhatsApp</a>
      </span>
    </div>
  </div>
  <div class="container header-inner">
    <a class="brand" href={url('/')}>
      <img src={url(site.logo)} alt="" width="40" height="40" />
      <span>{site.shortName}{suffix && <small> {suffix}</small>}</span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" class="main-nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          item.children ? (
            <li class="has-children">
              <details>
                <summary>{item.label}</summary>
                <ul class="submenu">
                  {item.children.map((c) => (
                    <li><a href={url(c.href)}><span>{c.label}</span>{c.desc && <small>{c.desc}</small>}</a></li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li><a href={url(item.href)}>{item.label}</a></li>
          )
        ))}
        <li class="nav-donate"><a class="btn btn-sm" href={site.donate.url}>{site.donate.label}</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector('.menu-toggle');
  const nav = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  const all = [...document.querySelectorAll<HTMLDetailsElement>('.main-nav details')];
  all.forEach((d) => d.addEventListener('toggle', () => d.open && all.filter((o) => o !== d).forEach((o) => (o.open = false))));
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.main-nav details')) all.forEach((o) => (o.open = false));
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && all.forEach((o) => (o.open = false)));
</script>
