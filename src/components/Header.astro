---
import { site, url } from '../lib/site';
const { overHero = false } = Astro.props;
const suffix = site.name.replace(site.shortName, '').trim();
---
<header class:list={['site-header', overHero && 'over-hero']}>
  <div class="topbar">
    <div class="container topbar-inner">
      <span>{site.address.street}, {site.address.city}</span>
      <span class="topbar-links">
        <a href={`tel:${site.phone}`}>{site.phone}</a>
        <a href={site.social.whatsapp}>{site.ui.socialLabels.whatsapp}</a>
      </span>
    </div>
  </div>
  <div class="container header-inner">
    <a class="brand" href={url('/')}>
      <img src={url(site.logo)} alt="" width="40" height="40" />
      <span>{site.shortName}{suffix && <small> {suffix}</small>}</span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" class="main-nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          item.children ? (
            <li class="has-children">
              <details>
                <summary>{item.label}</summary>
                <ul class="submenu">
                  {item.children.map((c) => (
                    <li><a href={url(c.href)}><span>{c.label}</span>{c.desc && <small>{c.desc}</small>}</a></li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li><a href={url(item.href)}>{item.label}</a></li>
          )
        ))}
        <li class="nav-donate"><a class="btn btn-sm" href={url(site.donate.page)}>{site.donate.label}</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('main-nav');
  const all = [...document.querySelectorAll<HTMLDetailsElement>('.main-nav details')];
  const setMenu = (open: boolean) => {
    nav?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('menu-open', open);
    document.documentElement.classList.toggle('nav-open', open);
  };
  btn?.addEventListener('click', () => setMenu(!nav?.classList.contains('open')));
  if (header?.classList.contains('over-hero')) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  }
  all.forEach((d) => d.addEventListener('toggle', () => d.open && all.filter((o) => o !== d).forEach((o) => (o.open = false))));
  // Close a submenu when focus moves out of it, or on a click elsewhere.
  all.forEach((d) => d.addEventListener('focusout', (e) => { if (!d.contains((e as FocusEvent).relatedTarget as Node)) d.open = false; }));
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.main-nav details')) all.forEach((o) => (o.open = false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    all.forEach((o) => (o.open = false));
    if (nav?.classList.contains('open')) { setMenu(false); btn?.focus(); }
  });
</script>
