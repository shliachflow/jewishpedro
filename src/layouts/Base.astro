---
import '@fontsource/instrument-serif';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../lib/site';

interface Props { title?: string; description?: string; overHero?: boolean }
const { title, description = site.description, overHero = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.shortName}` : site.name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.theme.primary} />
    <link rel="icon" href={url(site.logo)} />
    <style is:global set:html={`:root{--primary:${site.theme.primary};--accent:${site.theme.accent}}`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overHero={overHero} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
